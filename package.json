{
  "name": "dflow-erp",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "concurrently \"pnpm --filter @dflow/api dev\" \"pnpm --filter @dflow/web dev\"",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter @dflow/db db:generate",
    "db:migrate": "pnpm --filter @dflow/db db:migrate",
    "db:studio": "pnpm --filter @dflow/db db:studio",
    "db:seed": "pnpm --filter @dflow/db db:seed"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.8.3"
  }
}
