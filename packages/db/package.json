{
  "name": "@dflow/db",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "src/index.ts",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init_core_schema",
    "db:studio": "prisma studio",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "db:seed:metalkonstrukt": "dotenv -e ../../.env -- tsx prisma/seed-metalkonstrukt.ts",
    "db:seed:stadlogistik": "ts-node prisma/seed-stadlogistik.ts",
    "db:backup-cleanup": "dotenv -e ../../.env -- tsx scripts/backup-cleanup.ts"
  },
  "prisma": {
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "dotenv-cli": "^11.0.0",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.8.3"
  }
}
