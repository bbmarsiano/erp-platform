generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id            String          @id @default(cuid())
  name          String
  slug          String          @unique
  logoUrl       String?
  address       String?
  eik           String?
  vatNumber     String?
  vatRegistered Boolean         @default(false)
  mol           String?
  city          String?
  country       String          @default("България")
  phone         String?
  email         String?
  bankName      String?
  bankIban      String?
  isActive      Boolean         @default(true)
  enabledModules String[]       @default(["wms", "scm", "mes", "pos", "backup"])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  users         User[]
  licenseKey    LicenseKey?
  auditLogs     AuditLog[]
  warehouses    Warehouse[]
  products      Product[]
  stockMovements StockMovement[]
  goodsReceipts GoodsReceipt[]
  goodsIssues   GoodsIssue[]
  suppliers     Supplier[]
  purchaseOrders PurchaseOrder[]
  deliveries    Delivery[]
  billOfMaterials BillOfMaterials[]
  workOrders    WorkOrder[]
  cashRegisters CashRegister[]
  sales         Sale[]
  backupPolicies BackupPolicy[]
  backupJobs    BackupJob[]
  customers     Customer[]
  chartOfAccounts ChartOfAccount[]
  financialPeriods FinancialPeriod[]
  documentSequences DocumentSequence[]
  invoices      Invoice[]
  receivables   Receivable[]
  payables      Payable[]
  journalEntries JournalEntry[]
  bankAccounts  BankAccount[]
  bankTransactions BankTransaction[]
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  hashedPassword String
  firstName      String
  lastName       String
  role           UserRole  @default(OPERATOR)
  isActive       Boolean   @default(true)
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  auditLogs      AuditLog[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  OPERATOR
  READONLY
}

model LicenseKey {
  id          String    @id @default(cuid())
  tenantId    String    @unique
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  key         String    @unique
  expiresAt   DateTime
  features    Json      @default("[]")
  isActive    Boolean   @default(true)
  lastValidAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  payload   Json?
  ipAddress String?
  createdAt DateTime @default(now())
}

model Warehouse {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  code      String
  name      String
  address   String?
  isActive  Boolean    @default(true)
  locations Location[]
  receipts  GoodsReceipt[]
  issues    GoodsIssue[]
  purchaseOrders PurchaseOrder[]
  deliveries Delivery[]
  workOrders WorkOrder[]
  cashRegisters CashRegister[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([tenantId, code])
}

model Location {
  id           String       @id @default(cuid())
  warehouseId  String
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id])
  code         String
  name         String
  zone         String?
  locationType LocationType @default(STORAGE)
  isActive     Boolean      @default(true)
  stockItems   StockItem[]
  receiptLines GoodsReceiptLine[]
  issueLines   GoodsIssueLine[]
  deliveryLines DeliveryLine[]
  workOrderOutputs WorkOrder[]           @relation("WorkOrderOutput")
  consumptionLocations MaterialConsumption[] @relation("ConsumptionLocation")
  cashRegisters CashRegister[]
  saleLines SaleLine[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([warehouseId, code])
}

enum LocationType {
  STORAGE
  RECEIVING
  DISPATCH
  QUARANTINE
  PRODUCTION
}

model Product {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  code        String
  name        String
  barcode     String?         @unique
  description String?
  unit        String          @default("бр.")
  category    String?
  minStock    Float           @default(0)
  maxStock    Float?
  price       Float?
  isActive    Boolean         @default(true)
  stockItems  StockItem[]
  movements   StockMovement[]
  receiptLines GoodsReceiptLine[]
  issueLines   GoodsIssueLine[]
  purchaseOrderLines PurchaseOrderLine[]
  deliveryLines DeliveryLine[]
  bom             BillOfMaterials?
  bomComponents   BomItem[]         @relation("BomComponent")
  workOrders      WorkOrder[]       @relation("WorkOrderProduct")
  consumptions    MaterialConsumption[] @relation("ConsumptionProduct")
  saleLines       SaleLine[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([tenantId, code])
}

model StockItem {
  id          String    @id @default(cuid())
  tenantId    String
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  locationId  String
  location    Location  @relation(fields: [locationId], references: [id])
  quantity    Float     @default(0)
  reservedQty Float     @default(0)
  lotNumber   String?
  expiryDate  DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([productId, locationId, lotNumber])
}

model StockMovement {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  movementType   MovementType
  quantity       Float
  fromLocationId String?
  toLocationId   String?
  referenceType  String?
  referenceId    String?
  lotNumber      String?
  note           String?
  createdBy      String?
  createdAt      DateTime     @default(now())
}

enum MovementType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
}

model Supplier {
  id             String          @id @default(cuid())
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  code           String
  name           String
  contactName    String?
  email          String?
  phone          String?
  address        String?
  taxNumber      String?
  isActive       Boolean         @default(true)
  purchaseOrders PurchaseOrder[]
  invoices       Invoice[]
  payables       Payable[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([tenantId, code])
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  tenantId     String
  tenant       Tenant              @relation(fields: [tenantId], references: [id])
  orderNo      String
  supplierId   String
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  warehouseId  String
  warehouse    Warehouse           @relation(fields: [warehouseId], references: [id])
  status       PurchaseOrderStatus @default(DRAFT)
  expectedDate DateTime?
  note         String?
  lines        PurchaseOrderLine[]
  deliveries   Delivery[]
  createdBy    String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([tenantId, orderNo])
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Float
  receivedQty     Float         @default(0)
  unitPrice       Float?
  unit            String?
}

model Delivery {
  id              String         @id @default(cuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  deliveryNo      String
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  warehouseId     String
  warehouse       Warehouse      @relation(fields: [warehouseId], references: [id])
  supplierName    String?
  status          DocumentStatus @default(DRAFT)
  deliveryDate    DateTime?
  note            String?
  goodsReceiptId  String?
  lines           DeliveryLine[]
  createdBy       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([tenantId, deliveryNo])
}

model DeliveryLine {
  id         String   @id @default(cuid())
  deliveryId String
  delivery   Delivery @relation(fields: [deliveryId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  quantity   Float
  lotNumber  String?
  expiryDate DateTime?
}

model BillOfMaterials {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  productId   String    @unique
  product     Product   @relation(fields: [productId], references: [id])
  version     String    @default("1.0")
  isActive    Boolean   @default(true)
  items       BomItem[]
  workOrders  WorkOrder[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model BomItem {
  id            String          @id @default(cuid())
  bomId         String
  bom           BillOfMaterials @relation(fields: [bomId], references: [id])
  componentId   String
  component     Product         @relation("BomComponent", fields: [componentId], references: [id])
  quantity      Float
  unit          String?
  note          String?
}

model WorkOrder {
  id               String           @id @default(cuid())
  tenantId         String
  tenant           Tenant           @relation(fields: [tenantId], references: [id])
  orderNo          String
  productId        String
  product          Product          @relation("WorkOrderProduct", fields: [productId], references: [id])
  bomId            String?
  bom              BillOfMaterials? @relation(fields: [bomId], references: [id])
  warehouseId      String
  warehouse        Warehouse        @relation(fields: [warehouseId], references: [id])
  outputLocationId String
  outputLocation   Location         @relation("WorkOrderOutput", fields: [outputLocationId], references: [id])
  plannedQty       Float
  producedQty      Float            @default(0)
  status           WorkOrderStatus  @default(DRAFT)
  plannedStart     DateTime?
  plannedEnd       DateTime?
  actualStart      DateTime?
  actualEnd        DateTime?
  note             String?
  consumptions     MaterialConsumption[]
  createdBy        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([tenantId, orderNo])
}

enum WorkOrderStatus {
  DRAFT
  RELEASED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model MaterialConsumption {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])
  productId   String
  product     Product   @relation("ConsumptionProduct", fields: [productId], references: [id])
  locationId  String
  location    Location  @relation("ConsumptionLocation", fields: [locationId], references: [id])
  plannedQty  Float
  consumedQty Float     @default(0)
  lotNumber   String?
}

model CashRegister {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  code        String
  name        String
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  locationId  String
  location    Location  @relation(fields: [locationId], references: [id])
  isActive    Boolean   @default(true)
  sales       Sale[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, code])
}

model Sale {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  saleNo         String
  cashRegisterId String
  cashRegister   CashRegister  @relation(fields: [cashRegisterId], references: [id])
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id])
  paymentMethod  PaymentMethod @default(CASH)
  totalAmount    Float
  status         SaleStatus    @default(COMPLETED)
  note           String?
  lines          SaleLine[]
  createdBy      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([tenantId, saleNo])
  @@index([customerId])
}

enum PaymentMethod {
  CASH
  CARD
  MIXED
}

enum SaleStatus {
  COMPLETED
  REFUNDED
  CANCELLED
}

model BackupPolicy {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  name          String
  schedule      String
  retentionDays Int          @default(30)
  targetType    BackupTarget @default(LOCAL)
  targetPath    String?
  isActive      Boolean      @default(true)
  isEncrypted   Boolean      @default(true)
  jobs          BackupJob[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

enum BackupTarget {
  LOCAL
  NETWORK
  S3
}

model BackupJob {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  policyId    String?
  policy      BackupPolicy?   @relation(fields: [policyId], references: [id])
  status      BackupJobStatus @default(PENDING)
  startedAt   DateTime?
  completedAt DateTime?
  sizeBytes   BigInt?
  filePath    String?
  checksum    String?
  errorMsg    String?
  note        String?
  isVerified  Boolean         @default(false)
  createdAt   DateTime        @default(now())
}

enum BackupJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  VERIFIED
}

model SaleLine {
  id         String   @id @default(cuid())
  saleId     String
  sale       Sale     @relation(fields: [saleId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  quantity   Float
  unitPrice  Float
  totalPrice Float
  lotNumber  String?
}

model GoodsReceipt {
  id           String             @id @default(cuid())
  tenantId     String
  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  receiptNo    String
  warehouseId  String
  warehouse    Warehouse          @relation(fields: [warehouseId], references: [id])
  supplierName String?
  note         String?
  status       DocumentStatus     @default(DRAFT)
  lines        GoodsReceiptLine[]
  createdBy    String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([tenantId, receiptNo])
}

model GoodsReceiptLine {
  id         String       @id @default(cuid())
  receiptId  String
  receipt    GoodsReceipt @relation(fields: [receiptId], references: [id])
  productId  String
  product    Product      @relation(fields: [productId], references: [id])
  locationId String
  location   Location     @relation(fields: [locationId], references: [id])
  quantity   Float
  lotNumber  String?
  expiryDate DateTime?
}

model GoodsIssue {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  issueNo     String
  warehouseId String
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id])
  destination String?
  note        String?
  status      DocumentStatus  @default(DRAFT)
  lines       GoodsIssueLine[]
  createdBy   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([tenantId, issueNo])
}

model GoodsIssueLine {
  id         String    @id @default(cuid())
  issueId    String
  issue      GoodsIssue @relation(fields: [issueId], references: [id])
  productId  String
  product    Product   @relation(fields: [productId], references: [id])
  locationId String
  location   Location  @relation(fields: [locationId], references: [id])
  quantity   Float
  lotNumber  String?
}

enum DocumentStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

model Customer {
  id            String   @id @default(cuid())
  tenantId      String
  code          String
  name          String
  eik           String?
  vatNumber     String?
  address       String?
  city          String?
  email         String?
  phone         String?
  contactPerson String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  invoices      Invoice[]
  receivables   Receivable[]
  sales         Sale[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model ChartOfAccount {
  id          String           @id @default(cuid())
  tenantId    String
  code        String
  name        String
  accountType String
  parentId    String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  parent      ChartOfAccount?  @relation("AccountHierarchy", fields: [parentId], references: [id])
  children    ChartOfAccount[] @relation("AccountHierarchy")
  journalLines JournalEntryLine[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model FinancialPeriod {
  id        String    @id @default(cuid())
  tenantId  String
  year      Int
  month     Int
  isClosed  Boolean   @default(false)
  closedAt  DateTime?
  closedBy  String?
  tenant    Tenant    @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, year, month])
  @@index([tenantId])
}

model DocumentSequence {
  id         String @id @default(cuid())
  tenantId   String
  docType    String
  lastNumber Int    @default(0)
  prefix     String?
  tenant     Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, docType])
  @@index([tenantId])
}

model Invoice {
  id            String    @id @default(cuid())
  tenantId      String
  docType       String
  number        String
  issueDate     DateTime
  dueDate       DateTime?
  taxEventDate  DateTime?
  customerId    String?
  supplierId    String?
  currency      String    @default("BGN")
  subtotal      Decimal   @db.Decimal(12, 2)
  vatAmount     Decimal   @db.Decimal(12, 2)
  totalAmount   Decimal   @db.Decimal(12, 2)
  vatRate       Decimal   @default(20.00) @db.Decimal(5, 2)
  status        String    @default("DRAFT")
  note          String?
  relatedPOId   String?
  relatedSaleId String?
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  customer   Customer?     @relation(fields: [customerId], references: [id])
  supplier   Supplier?     @relation(fields: [supplierId], references: [id])
  lines      InvoiceLine[]
  receivable Receivable?
  payable    Payable?

  @@unique([tenantId, docType, number])
  @@index([tenantId])
  @@index([customerId])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  productId   String?
  description String
  quantity    Decimal @db.Decimal(12, 3)
  unitPrice   Decimal @db.Decimal(12, 2)
  vatRate     Decimal @default(20.00) @db.Decimal(5, 2)
  lineTotal   Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Receivable {
  id         String   @id @default(cuid())
  tenantId   String
  invoiceId  String   @unique
  customerId String
  amountDue  Decimal  @db.Decimal(12, 2)
  amountPaid Decimal  @default(0) @db.Decimal(12, 2)
  dueDate    DateTime
  status     String   @default("OPEN")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  invoice  Invoice  @relation(fields: [invoiceId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([tenantId])
  @@index([status])
}

model Payable {
  id         String   @id @default(cuid())
  tenantId   String
  invoiceId  String   @unique
  supplierId String
  amountDue  Decimal  @db.Decimal(12, 2)
  amountPaid Decimal  @default(0) @db.Decimal(12, 2)
  dueDate    DateTime
  status     String   @default("OPEN")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  invoice  Invoice  @relation(fields: [invoiceId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@index([tenantId])
  @@index([status])
}

model JournalEntry {
  id          String   @id @default(cuid())
  tenantId    String
  entryDate   DateTime
  description String
  sourceType  String
  sourceId    String?
  isPosted    Boolean  @default(true)
  createdBy   String
  createdAt   DateTime @default(now())

  tenant Tenant             @relation(fields: [tenantId], references: [id])
  lines  JournalEntryLine[]

  @@index([tenantId])
  @@index([sourceType, sourceId])
}

model JournalEntryLine {
  id             String  @id @default(cuid())
  journalEntryId String
  accountId      String
  debit          Decimal @default(0) @db.Decimal(12, 2)
  credit         Decimal @default(0) @db.Decimal(12, 2)
  description    String?

  journalEntry JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      ChartOfAccount @relation(fields: [accountId], references: [id])
}

model BankAccount {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  iban      String
  currency  String   @default("BGN")
  bankName  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  transactions BankTransaction[]

  @@unique([tenantId, iban])
  @@index([tenantId])
}

model BankTransaction {
  id              String    @id @default(cuid())
  tenantId        String
  bankAccountId   String
  transactionDate DateTime
  valueDate       DateTime?
  amount          Decimal   @db.Decimal(12, 2)
  description     String
  counterparty    String?
  referenceNumber String?
  transactionType String
  matchedType     String?
  matchedId       String?
  isReconciled    Boolean   @default(false)
  createdBy       String
  createdAt       DateTime  @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])

  @@index([tenantId])
  @@index([bankAccountId])
  @@index([matchedType, matchedId])
}
