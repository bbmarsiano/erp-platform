generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id            String          @id @default(cuid())
  name          String
  slug          String          @unique
  logoUrl       String?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  users         User[]
  licenseKey    LicenseKey?
  auditLogs     AuditLog[]
  warehouses    Warehouse[]
  products      Product[]
  stockMovements StockMovement[]
  goodsReceipts GoodsReceipt[]
  goodsIssues   GoodsIssue[]
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  hashedPassword String
  firstName      String
  lastName       String
  role           UserRole  @default(OPERATOR)
  isActive       Boolean   @default(true)
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  auditLogs      AuditLog[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  OPERATOR
  READONLY
}

model LicenseKey {
  id          String    @id @default(cuid())
  tenantId    String    @unique
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  key         String    @unique
  expiresAt   DateTime
  features    Json      @default("[]")
  isActive    Boolean   @default(true)
  lastValidAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  payload   Json?
  ipAddress String?
  createdAt DateTime @default(now())
}

model Warehouse {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  code      String
  name      String
  address   String?
  isActive  Boolean    @default(true)
  locations Location[]
  receipts  GoodsReceipt[]
  issues    GoodsIssue[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([tenantId, code])
}

model Location {
  id           String       @id @default(cuid())
  warehouseId  String
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id])
  code         String
  name         String
  zone         String?
  locationType LocationType @default(STORAGE)
  isActive     Boolean      @default(true)
  stockItems   StockItem[]
  receiptLines GoodsReceiptLine[]
  issueLines   GoodsIssueLine[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([warehouseId, code])
}

enum LocationType {
  STORAGE
  RECEIVING
  DISPATCH
  QUARANTINE
  PRODUCTION
}

model Product {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  code        String
  name        String
  description String?
  unit        String          @default("бр.")
  category    String?
  minStock    Float           @default(0)
  maxStock    Float?
  isActive    Boolean         @default(true)
  stockItems  StockItem[]
  movements   StockMovement[]
  receiptLines GoodsReceiptLine[]
  issueLines   GoodsIssueLine[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([tenantId, code])
}

model StockItem {
  id          String    @id @default(cuid())
  tenantId    String
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  locationId  String
  location    Location  @relation(fields: [locationId], references: [id])
  quantity    Float     @default(0)
  reservedQty Float     @default(0)
  lotNumber   String?
  expiryDate  DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([productId, locationId, lotNumber])
}

model StockMovement {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  movementType   MovementType
  quantity       Float
  fromLocationId String?
  toLocationId   String?
  referenceType  String?
  referenceId    String?
  lotNumber      String?
  note           String?
  createdBy      String?
  createdAt      DateTime     @default(now())
}

enum MovementType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
}

model GoodsReceipt {
  id           String             @id @default(cuid())
  tenantId     String
  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  receiptNo    String
  warehouseId  String
  warehouse    Warehouse          @relation(fields: [warehouseId], references: [id])
  supplierName String?
  note         String?
  status       DocumentStatus     @default(DRAFT)
  lines        GoodsReceiptLine[]
  createdBy    String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([tenantId, receiptNo])
}

model GoodsReceiptLine {
  id         String       @id @default(cuid())
  receiptId  String
  receipt    GoodsReceipt @relation(fields: [receiptId], references: [id])
  productId  String
  product    Product      @relation(fields: [productId], references: [id])
  locationId String
  location   Location     @relation(fields: [locationId], references: [id])
  quantity   Float
  lotNumber  String?
  expiryDate DateTime?
}

model GoodsIssue {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  issueNo     String
  warehouseId String
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id])
  destination String?
  note        String?
  status      DocumentStatus  @default(DRAFT)
  lines       GoodsIssueLine[]
  createdBy   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([tenantId, issueNo])
}

model GoodsIssueLine {
  id         String    @id @default(cuid())
  issueId    String
  issue      GoodsIssue @relation(fields: [issueId], references: [id])
  productId  String
  product    Product   @relation(fields: [productId], references: [id])
  locationId String
  location   Location  @relation(fields: [locationId], references: [id])
  quantity   Float
  lotNumber  String?
}

enum DocumentStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}
