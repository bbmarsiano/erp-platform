generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id            String          @id @default(cuid())
  name          String
  slug          String          @unique
  logoUrl       String?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  users         User[]
  licenseKey    LicenseKey?
  auditLogs     AuditLog[]
  warehouses    Warehouse[]
  products      Product[]
  stockMovements StockMovement[]
  goodsReceipts GoodsReceipt[]
  goodsIssues   GoodsIssue[]
  suppliers     Supplier[]
  purchaseOrders PurchaseOrder[]
  deliveries    Delivery[]
  billOfMaterials BillOfMaterials[]
  workOrders    WorkOrder[]
  cashRegisters CashRegister[]
  sales         Sale[]
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  hashedPassword String
  firstName      String
  lastName       String
  role           UserRole  @default(OPERATOR)
  isActive       Boolean   @default(true)
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  auditLogs      AuditLog[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  OPERATOR
  READONLY
}

model LicenseKey {
  id          String    @id @default(cuid())
  tenantId    String    @unique
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  key         String    @unique
  expiresAt   DateTime
  features    Json      @default("[]")
  isActive    Boolean   @default(true)
  lastValidAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  payload   Json?
  ipAddress String?
  createdAt DateTime @default(now())
}

model Warehouse {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  code      String
  name      String
  address   String?
  isActive  Boolean    @default(true)
  locations Location[]
  receipts  GoodsReceipt[]
  issues    GoodsIssue[]
  purchaseOrders PurchaseOrder[]
  deliveries Delivery[]
  workOrders WorkOrder[]
  cashRegisters CashRegister[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([tenantId, code])
}

model Location {
  id           String       @id @default(cuid())
  warehouseId  String
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id])
  code         String
  name         String
  zone         String?
  locationType LocationType @default(STORAGE)
  isActive     Boolean      @default(true)
  stockItems   StockItem[]
  receiptLines GoodsReceiptLine[]
  issueLines   GoodsIssueLine[]
  deliveryLines DeliveryLine[]
  workOrderOutputs WorkOrder[]           @relation("WorkOrderOutput")
  consumptionLocations MaterialConsumption[] @relation("ConsumptionLocation")
  cashRegisters CashRegister[]
  saleLines SaleLine[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([warehouseId, code])
}

enum LocationType {
  STORAGE
  RECEIVING
  DISPATCH
  QUARANTINE
  PRODUCTION
}

model Product {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  code        String
  name        String
  description String?
  unit        String          @default("бр.")
  category    String?
  minStock    Float           @default(0)
  maxStock    Float?
  isActive    Boolean         @default(true)
  stockItems  StockItem[]
  movements   StockMovement[]
  receiptLines GoodsReceiptLine[]
  issueLines   GoodsIssueLine[]
  purchaseOrderLines PurchaseOrderLine[]
  deliveryLines DeliveryLine[]
  bom             BillOfMaterials?
  bomComponents   BomItem[]         @relation("BomComponent")
  workOrders      WorkOrder[]       @relation("WorkOrderProduct")
  consumptions    MaterialConsumption[] @relation("ConsumptionProduct")
  saleLines       SaleLine[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([tenantId, code])
}

model StockItem {
  id          String    @id @default(cuid())
  tenantId    String
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  locationId  String
  location    Location  @relation(fields: [locationId], references: [id])
  quantity    Float     @default(0)
  reservedQty Float     @default(0)
  lotNumber   String?
  expiryDate  DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([productId, locationId, lotNumber])
}

model StockMovement {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  movementType   MovementType
  quantity       Float
  fromLocationId String?
  toLocationId   String?
  referenceType  String?
  referenceId    String?
  lotNumber      String?
  note           String?
  createdBy      String?
  createdAt      DateTime     @default(now())
}

enum MovementType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
}

model Supplier {
  id             String          @id @default(cuid())
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  code           String
  name           String
  contactName    String?
  email          String?
  phone          String?
  address        String?
  taxNumber      String?
  isActive       Boolean         @default(true)
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([tenantId, code])
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  tenantId     String
  tenant       Tenant              @relation(fields: [tenantId], references: [id])
  orderNo      String
  supplierId   String
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  warehouseId  String
  warehouse    Warehouse           @relation(fields: [warehouseId], references: [id])
  status       PurchaseOrderStatus @default(DRAFT)
  expectedDate DateTime?
  note         String?
  lines        PurchaseOrderLine[]
  deliveries   Delivery[]
  createdBy    String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([tenantId, orderNo])
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Float
  receivedQty     Float         @default(0)
  unitPrice       Float?
  unit            String?
}

model Delivery {
  id              String         @id @default(cuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  deliveryNo      String
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  warehouseId     String
  warehouse       Warehouse      @relation(fields: [warehouseId], references: [id])
  supplierName    String?
  status          DocumentStatus @default(DRAFT)
  deliveryDate    DateTime?
  note            String?
  goodsReceiptId  String?
  lines           DeliveryLine[]
  createdBy       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([tenantId, deliveryNo])
}

model DeliveryLine {
  id         String   @id @default(cuid())
  deliveryId String
  delivery   Delivery @relation(fields: [deliveryId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  quantity   Float
  lotNumber  String?
  expiryDate DateTime?
}

model BillOfMaterials {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  productId   String    @unique
  product     Product   @relation(fields: [productId], references: [id])
  version     String    @default("1.0")
  isActive    Boolean   @default(true)
  items       BomItem[]
  workOrders  WorkOrder[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model BomItem {
  id            String          @id @default(cuid())
  bomId         String
  bom           BillOfMaterials @relation(fields: [bomId], references: [id])
  componentId   String
  component     Product         @relation("BomComponent", fields: [componentId], references: [id])
  quantity      Float
  unit          String?
  note          String?
}

model WorkOrder {
  id               String           @id @default(cuid())
  tenantId         String
  tenant           Tenant           @relation(fields: [tenantId], references: [id])
  orderNo          String
  productId        String
  product          Product          @relation("WorkOrderProduct", fields: [productId], references: [id])
  bomId            String?
  bom              BillOfMaterials? @relation(fields: [bomId], references: [id])
  warehouseId      String
  warehouse        Warehouse        @relation(fields: [warehouseId], references: [id])
  outputLocationId String
  outputLocation   Location         @relation("WorkOrderOutput", fields: [outputLocationId], references: [id])
  plannedQty       Float
  producedQty      Float            @default(0)
  status           WorkOrderStatus  @default(DRAFT)
  plannedStart     DateTime?
  plannedEnd       DateTime?
  actualStart      DateTime?
  actualEnd        DateTime?
  note             String?
  consumptions     MaterialConsumption[]
  createdBy        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([tenantId, orderNo])
}

enum WorkOrderStatus {
  DRAFT
  RELEASED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model MaterialConsumption {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])
  productId   String
  product     Product   @relation("ConsumptionProduct", fields: [productId], references: [id])
  locationId  String
  location    Location  @relation("ConsumptionLocation", fields: [locationId], references: [id])
  plannedQty  Float
  consumedQty Float     @default(0)
  lotNumber   String?
}

model CashRegister {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  code        String
  name        String
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  locationId  String
  location    Location  @relation(fields: [locationId], references: [id])
  isActive    Boolean   @default(true)
  sales       Sale[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, code])
}

model Sale {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  saleNo         String
  cashRegisterId String
  cashRegister   CashRegister  @relation(fields: [cashRegisterId], references: [id])
  paymentMethod  PaymentMethod @default(CASH)
  totalAmount    Float
  status         SaleStatus    @default(COMPLETED)
  note           String?
  lines          SaleLine[]
  createdBy      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([tenantId, saleNo])
}

enum PaymentMethod {
  CASH
  CARD
  MIXED
}

enum SaleStatus {
  COMPLETED
  REFUNDED
  CANCELLED
}

model SaleLine {
  id         String   @id @default(cuid())
  saleId     String
  sale       Sale     @relation(fields: [saleId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  quantity   Float
  unitPrice  Float
  totalPrice Float
  lotNumber  String?
}

model GoodsReceipt {
  id           String             @id @default(cuid())
  tenantId     String
  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  receiptNo    String
  warehouseId  String
  warehouse    Warehouse          @relation(fields: [warehouseId], references: [id])
  supplierName String?
  note         String?
  status       DocumentStatus     @default(DRAFT)
  lines        GoodsReceiptLine[]
  createdBy    String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([tenantId, receiptNo])
}

model GoodsReceiptLine {
  id         String       @id @default(cuid())
  receiptId  String
  receipt    GoodsReceipt @relation(fields: [receiptId], references: [id])
  productId  String
  product    Product      @relation(fields: [productId], references: [id])
  locationId String
  location   Location     @relation(fields: [locationId], references: [id])
  quantity   Float
  lotNumber  String?
  expiryDate DateTime?
}

model GoodsIssue {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  issueNo     String
  warehouseId String
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id])
  destination String?
  note        String?
  status      DocumentStatus  @default(DRAFT)
  lines       GoodsIssueLine[]
  createdBy   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([tenantId, issueNo])
}

model GoodsIssueLine {
  id         String    @id @default(cuid())
  issueId    String
  issue      GoodsIssue @relation(fields: [issueId], references: [id])
  productId  String
  product    Product   @relation(fields: [productId], references: [id])
  locationId String
  location   Location  @relation(fields: [locationId], references: [id])
  quantity   Float
  lotNumber  String?
}

enum DocumentStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}
