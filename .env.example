# Local PostgreSQL (dev)
DATABASE_URL="postgresql://dimitarmitrev@localhost:5432/erp_dev"

# Supabase License Server
LICENSE_SERVER_URL="https://YOUR_PROJECT.supabase.co"
LICENSE_SERVER_KEY="your-supabase-anon-key"
LICENSE_KEY="YOUR-LICENSE-KEY"

# JWT
JWT_SECRET="change-this-to-a-random-32-char-string"
JWT_REFRESH_SECRET="change-this-to-another-random-32-char-string"

# App
NODE_ENV="development"
PORT=3001

# Frontend
VITE_API_URL="http://localhost:3001"

# Backup storage (used when BackupPolicy.targetPath is not set)
# Dev default: <project-root>/backups  |  Production default: /opt/dflow-erp/backups
BACKUP_STORAGE_PATH="./backups"

# Backup encryption (required when BackupPolicy.isEncrypted is true)
# Generate once: openssl rand -hex 32
BACKUP_ENCRYPTION_KEY=""
